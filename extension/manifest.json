{
  "manifest_version": 3,
  "name": "플로우 큐 (한글 지원)",
  "description": "Google Flow에서 Veo·Nano Banana 프롬프트를 순서대로 자동 제출합니다. 한글 프롬프트를 지원합니다.",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["https://flow.google.com/*", "https://labs.google/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "플로우 큐 열기" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
